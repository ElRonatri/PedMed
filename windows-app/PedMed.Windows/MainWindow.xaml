<Window x:Class="PedMed.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PedMed.Windows.Views"
        Title="PedMed — Calculadora de dosis pediátrica" Height="900" Width="1280"
        FontFamily="Segoe UI" Background="#F4F7FB">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="PedMed" FontSize="30" FontWeight="Bold" Foreground="#0A4F63"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Calculadora de dosis pediátrica por peso — funcionamiento 100% sin conexión"
                       FontSize="14" Foreground="#5A6B7B" HorizontalAlignment="Center" Margin="0,2,0,12" />

            <Border Background="#FBE6E6" BorderBrush="#C53030" BorderThickness="1" CornerRadius="8"
                    Padding="14" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap" FontSize="12">
                    <Run FontWeight="Bold" Text="Aviso importante: " />
                    <Run
                        Text="esta herramienta es solo con fines educativos y de apoyo. No sustituye el criterio clínico, la ficha técnica del medicamento ni la evaluación de un médico o farmacéutico. Verifique siempre las dosis antes de administrar cualquier medicamento a un paciente pediátrico." />
                </TextBlock>
            </Border>
        </StackPanel>

        <TabControl>
            <TabItem Header="Principal (Ambulatorio / Urgencias)">
                <views:PatientPanelView Margin="12,16,0,0" DataContext="{Binding PrincipalPanel}" />
            </TabItem>
            <TabItem Header="Hospitalización / UCI / Quirófano">
                <DockPanel Margin="12,16,0,0">
                    <Border DockPanel.Dock="Top" Background="#2B1230" BorderBrush="#6B2A80" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#F4D9FF">
                            <Run FontWeight="Bold" Text="Contenido de anestesiología/cuidados críticos: " />
                            <Run
                                Text="esta pestaña reúne fármacos de uso exclusivamente hospitalario (UCI, quirófano y planta de hospitalización): anestesia, sedación, relajantes musculares, vasopresores/infusiones IV, antiarrítmicos especializados y antibióticos IV de infecciones graves. Requieren vía IV/IM/IO, monitorización continua, capacidad de soporte de vía aérea y personal entrenado; no están pensados para administración en el hogar ni sin supervisión médica directa." />
                        </TextBlock>
                    </Border>
                    <views:PatientPanelView DataContext="{Binding HospitalPanel}" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
