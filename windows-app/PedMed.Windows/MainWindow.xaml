<Window x:Class="PedMed.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PedMed.Windows.Views"
        Title="PedMed — Calculadora de dosis pediátrica" Height="900" Width="1280"
        Icon="Assets/app.ico"
        FontFamily="Segoe UI" Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel Margin="20">
        <Grid DockPanel.Dock="Top">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="PedMed" FontSize="30" FontWeight="Bold"
                           Foreground="{DynamicResource HeaderBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Calculadora de dosis pediátrica por peso — funcionamiento 100% sin conexión"
                           FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                <TextBlock Text="Creado por Rodrigo Padilla" FontSize="11" FontStyle="Italic"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                           Margin="0,2,0,12" />
            </StackPanel>

            <Button x:Name="ThemeToggleButton" Content="🌙 Modo oscuro" Click="ThemeToggleButton_OnClick"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,6" BorderThickness="0"
                    Cursor="Hand" FontSize="12" FontWeight="SemiBold"
                    Background="{DynamicResource ThemeToggleBackgroundBrush}"
                    Foreground="{DynamicResource ThemeToggleTextBrush}" />
        </Grid>

        <StackPanel DockPanel.Dock="Top">
            <Border Background="{DynamicResource DisclaimerBackgroundBrush}"
                    BorderBrush="{DynamicResource DisclaimerBorderBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="14" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DisclaimerTextBrush}">
                    <Run FontWeight="Bold" Text="Aviso importante: " />
                    <Run
                        Text="esta herramienta es solo con fines educativos y de apoyo. No sustituye el criterio clínico, la ficha técnica del medicamento ni la evaluación de un médico o farmacéutico. Verifique siempre las dosis antes de administrar cualquier medicamento a un paciente pediátrico." />
                </TextBlock>
            </Border>
        </StackPanel>

        <TabControl>
            <TabItem Header="Principal (Ambulatorio / Urgencias)">
                <views:PatientPanelView Margin="12,16,0,0" DataContext="{Binding PrincipalPanel}" />
            </TabItem>
            <TabItem Header="Hospitalización / UCI / Quirófano">
                <DockPanel Margin="12,16,0,0">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource HospitalBannerBackgroundBrush}"
                            BorderBrush="{DynamicResource HospitalBannerBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource HospitalBannerTextBrush}">
                            <Run FontWeight="Bold" Text="Contenido de anestesiología/cuidados críticos: " />
                            <Run
                                Text="esta pestaña reúne fármacos de uso exclusivamente hospitalario (UCI, quirófano y planta de hospitalización): anestesia, sedación, relajantes musculares, vasopresores/infusiones IV, antiarrítmicos especializados y antibióticos IV de infecciones graves. Requieren vía IV/IM/IO, monitorización continua, capacidad de soporte de vía aérea y personal entrenado; no están pensados para administración en el hogar ni sin supervisión médica directa." />
                        </TextBlock>
                    </Border>
                    <views:PatientPanelView DataContext="{Binding HospitalPanel}" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Neonatología (UCI neonatal)">
                <DockPanel Margin="12,16,0,0">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource HospitalBannerBackgroundBrush}"
                            BorderBrush="{DynamicResource HospitalBannerBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource HospitalBannerTextBrush}">
                            <Run FontWeight="Bold" Text="Contenido de UCI neonatal: " />
                            <Run
                                Text="esta pestaña reúne fármacos dosificados según la edad gestacional al nacer y la edad postnatal del neonato (no por edad en meses/años como el resto de la app), de uso exclusivamente hospitalario en cuidados intensivos neonatales. La dosificación neonatal es especialmente sensible a errores: verifique siempre cada cálculo contra el protocolo de neonatología/farmacia de su institución antes de administrar cualquier medicamento." />
                        </TextBlock>
                    </Border>
                    <views:NeonatalPanelView DataContext="{Binding NeonatalPanel}" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
