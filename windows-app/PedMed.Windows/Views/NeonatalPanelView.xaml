<UserControl x:Class="PedMed.Windows.Views.NeonatalPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PedMed.Windows.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NeonatalPanelViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="DoseLineTemplate" DataType="{x:Type vm:DoseLineViewModel}">
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" TextAlignment="Right"
                           VerticalAlignment="Top" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MedicationCardTemplate" DataType="{x:Type vm:MedicationCardViewModel}">
            <Border BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                    Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Margin="6" Width="320"
                    VerticalAlignment="Top">
                <StackPanel>
                    <Border Background="{Binding RibbonBackground}" Padding="8,6" CornerRadius="8,8,0,0"
                            Visibility="{Binding HasRibbon, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding RibbonText}" Foreground="{Binding RibbonForeground}"
                                   FontSize="10" FontWeight="Bold" TextWrapping="Wrap" />
                    </Border>

                    <Border BorderThickness="0,0,0,0" Padding="12">
                        <StackPanel>
                            <Border BorderThickness="6,0,0,0" BorderBrush="{Binding CardBorderBrush}"
                                    Padding="8,0,0,0" Margin="-12,-12,-12,0">
                                <StackPanel Margin="4,10,10,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"
                                                   FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{Binding SafetyBadgeBackground}"
                                                CornerRadius="10" Padding="6,2" Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SafetyLabel}"
                                                       Foreground="{Binding SafetyBadgeForeground}"
                                                       FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding Indication}" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,6,0,6" />

                                    <TextBlock Text="{Binding Placeholder}" FontStyle="Italic"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12" TextWrapping="Wrap"
                                               Visibility="{Binding HasPlaceholder, Converter={StaticResource BoolToVis}}" />

                                    <Border Background="{DynamicResource DoseBlockBackgroundBrush}" CornerRadius="6"
                                            Padding="8" Margin="0,0,0,6"
                                            Visibility="{Binding HasDose, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding DoseLines}"
                                                      ItemTemplate="{StaticResource DoseLineTemplate}" />
                                    </Border>

                                    <TextBlock Text="{Binding SafetyText}" Foreground="{Binding SafetyTextColor}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />

                                    <TextBlock Text="{Binding GeneralWarning}" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6" />

                                    <ItemsControl ItemsSource="{Binding Sources}"
                                                  Visibility="{Binding HasSources, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,0,0,2"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}">
                                                        <Run Text="Fuente: " />
                                                        <Hyperlink NavigateUri="{Binding Url}"
                                                                   RequestNavigate="Hyperlink_OnRequestNavigate">
                                                            <Run Text="{Binding Label}" />
                                                        </Hyperlink>
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,0,0,2"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Visibility="{Binding HasNoUrl, Converter={StaticResource BoolToVis}}">
                                                        <Run Text="Fuente: " />
                                                        <Run Text="{Binding Label}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,32,0" Width="200">
                    <TextBlock Text="Peso actual (kg)" FontWeight="SemiBold"
                               Foreground="{DynamicResource HeaderBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}" Padding="8" FontSize="14" />
                </StackPanel>
                <StackPanel Margin="0,0,32,0" Width="260">
                    <TextBlock Text="Edad gestacional al nacer (semanas)" FontWeight="SemiBold"
                               Foreground="{DynamicResource HeaderBrush}" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <TextBox Text="{Binding GestationalWeeksText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}" Padding="8" FontSize="14" />
                    <TextBlock Text="Semanas completadas de gestación al momento del nacimiento."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Width="280">
                    <TextBlock Text="Edad postnatal (días de vida)" FontWeight="SemiBold"
                               Foreground="{DynamicResource HeaderBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding PostnatalDaysText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}" Padding="8" FontSize="14" />
                    <TextBlock Text="Días transcurridos desde el nacimiento. La dosificación neonatal depende de ambas edades a la vez."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding WeightError}" Foreground="{DynamicResource ErrorTextBrush}"
                       FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"
                       Visibility="{Binding HasWeightError, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding GestationalError}" Foreground="{DynamicResource ErrorTextBrush}"
                       FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"
                       Visibility="{Binding HasGestationalError, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding PostnatalError}" Foreground="{DynamicResource ErrorTextBrush}"
                       FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"
                       Visibility="{Binding HasPostnatalError, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Buscar medicamento" FontWeight="SemiBold"
                       Foreground="{DynamicResource HeaderBrush}" Margin="0,0,0,6" />
            <Grid Width="420" HorizontalAlignment="Left">
                <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}" Padding="8,8,28,8" FontSize="14" />
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                        Padding="4,0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}"
                        Click="ClearSearchButton_OnClick" />
                <Popup PlacementTarget="{Binding ElementName=SearchTextBox}" Placement="Bottom" Width="420"
                       IsOpen="{Binding IsSuggestionsOpen}" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8"
                            MaxHeight="280" Margin="0,2,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Suggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MedicationCardViewModel}">
                                        <Button Content="{Binding Name}" HorizontalContentAlignment="Left"
                                                Background="Transparent" BorderThickness="0" Padding="10,8"
                                                Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand"
                                                Click="SuggestionButton_OnClick" Tag="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"
                       Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}">
                <Run Text="{Binding MatchCount, Mode=OneWay}" />
                <Run Text=" medicamento(s) coincide(n)." />
            </TextBlock>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoryGroupViewModel}">
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource HeaderBrush}" Margin="0,0,0,4" />
                            <Border BorderThickness="0,0,0,2" BorderBrush="{DynamicResource AccentBrush}"
                                    Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Cards}"
                                          ItemTemplate="{StaticResource MedicationCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
