<UserControl x:Class="PedMed.Windows.Views.PatientPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PedMed.Windows.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PatientPanelViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="DoseLineTemplate" DataType="{x:Type vm:DoseLineViewModel}">
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#5A6B7B" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" FontSize="12"
                           TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Top" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MedicationCardTemplate" DataType="{x:Type vm:MedicationCardViewModel}">
            <Border BorderThickness="1" BorderBrush="#DFE6EE" Background="White" CornerRadius="8"
                    Margin="6" Width="320" VerticalAlignment="Top">
                <StackPanel>
                    <Border Background="{Binding RibbonBackground}" Padding="8,6" CornerRadius="8,8,0,0"
                            Visibility="{Binding HasRibbon, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding RibbonText}" Foreground="{Binding RibbonForeground}"
                                   FontSize="10" FontWeight="Bold" TextWrapping="Wrap" />
                    </Border>

                    <Border BorderThickness="0,0,0,0" Padding="12">
                        <StackPanel>
                            <Border BorderThickness="6,0,0,0" BorderBrush="{Binding CardBorderBrush}"
                                    Padding="8,0,0,0" Margin="-12,-12,-12,0">
                                <StackPanel Margin="4,10,10,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold"
                                                   FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{Binding SafetyBadgeBackground}"
                                                CornerRadius="10" Padding="6,2" Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SafetyLabel}"
                                                       Foreground="{Binding SafetyBadgeForeground}"
                                                       FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding Indication}" Foreground="#5A6B7B" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,6,0,6" />

                                    <TextBlock Text="{Binding Placeholder}" FontStyle="Italic" Foreground="#5A6B7B"
                                               FontSize="12" TextWrapping="Wrap"
                                               Visibility="{Binding HasPlaceholder, Converter={StaticResource BoolToVis}}" />

                                    <Border Background="#F7FAFC" CornerRadius="6" Padding="8" Margin="0,0,0,6"
                                            Visibility="{Binding HasDose, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding DoseLines}"
                                                      ItemTemplate="{StaticResource DoseLineTemplate}" />
                                    </Border>

                                    <TextBlock Text="{Binding SafetyText}" Foreground="{Binding SafetyTextColor}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />

                                    <TextBlock Text="{Binding GeneralWarning}" Foreground="#5A6B7B" FontSize="10"
                                               TextWrapping="Wrap" Margin="0,0,0,6" />

                                    <ItemsControl ItemsSource="{Binding Sources}"
                                                  Visibility="{Binding HasSources, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,0,0,2">
                                                    <Run Text="Fuente: " />
                                                    <Hyperlink NavigateUri="{Binding Url}"
                                                               RequestNavigate="Hyperlink_OnRequestNavigate">
                                                        <Run Text="{Binding Label}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DFE6EE" BorderThickness="1"
                CornerRadius="12" Padding="20" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,32,0" Width="220">
                    <TextBlock Text="Peso del paciente (kg)" FontWeight="SemiBold" Foreground="#0A4F63"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8" FontSize="14" />
                </StackPanel>
                <StackPanel Width="260">
                    <TextBlock Text="Edad (opcional, recomendada)" FontWeight="SemiBold" Foreground="#0A4F63"
                               Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding AgeText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8" FontSize="14" Width="140" />
                        <ComboBox ItemsSource="{Binding AgeUnits}" SelectedItem="{Binding AgeUnit}"
                                  Margin="8,0,0,0" Width="100" Padding="6" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="La edad permite validar la seguridad de cada medicamento. Sin edad, deberá verificar manualmente las restricciones."
                               Foreground="#5A6B7B" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{Binding FormError}" Foreground="#C53030" FontWeight="Bold"
                   Margin="0,0,0,8" TextWrapping="Wrap"
                   Visibility="{Binding HasFormError, Converter={StaticResource BoolToVis}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoryGroupViewModel}">
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#0A4F63"
                                       Margin="0,0,0,4" />
                            <Border BorderThickness="0,0,0,2" BorderBrush="#0F6F8C" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Cards}"
                                          ItemTemplate="{StaticResource MedicationCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
